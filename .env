# Committed defaults. Machine-specific overrides go in .env.local (gitignored).
# Dev is the default environment; prod must be opted into explicitly.

APP_ENV=dev

# --- world ---
VOXEL_WORLD_X=8
VOXEL_WORLD_Y=4
VOXEL_WORLD_Z=8
VOXEL_WORLD_SEED=1337

# --- cave carver ---
# density = Pass 2A (O(N^3) 3D noise), sparse = Pass 2B (O(S) stamp carving)
VOXEL_CARVER=density
# Origins per 1000 voxels-cubed. Tuned so the sparse carver carves about 20% of
# the rock, matching the density carver's threshold and giving comparable cave
# systems to compare. See PROJECT.md and the parity test in voxel-core.
VOXEL_CAVE_ORIGIN_DENSITY=2.0
VOXEL_CAVE_MIN_RADIUS=1.5
VOXEL_CAVE_MAX_RADIUS=4.0

# --- logging / debugging ---
# Scoped to our own crates on purpose. A bare `debug` turns on wgpu, naga and
# wayland internals too, which buries the app's own output in hundreds of lines
# of Vulkan loader chatter at startup. Use `RUST_LOG=debug` explicitly when
# those are actually what you are debugging.
RUST_LOG=voxel_core=debug,voxel_app=debug
VOXEL_VALIDATION=1
VOXEL_DEBUG_VIEWS=1
VOXEL_FRAME_DUMP=0

# --- renderer ---
# 0 = let wgpu choose (native GPU). Set to 1 to force the CPU backend when
# /dev/dri is unreachable (sandbox, CI, headless boxes).
VOXEL_FORCE_SOFTWARE_GPU=0
VOXEL_VSYNC=0
